# Google Sheet configuration
GOOGLE_SHEET_ID=1_-T8jq6e19ecEF-KaVeDFHbIJgmcSU3zWhOM6_UquX8
GOOGLE_SHEET_NAME=Customers
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json

# Optional dedicated blank cell used only by `npm run verify:write`.
# The command writes a temporary marker, verifies it, and restores the old value.
# Example: Phase2 Test!A1
GOOGLE_TEST_CELL=

# OpenWA integration
GOOGLE_REVIEW_URL=https://api.dhanda.app/r/1d60libv
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_API_KEY_FILE=
OPENWA_SESSION_ID=
OPENWA_SESSION_NAME=swastik-shop

# Phase 3 safety: sending stays disabled until the dry-run is reviewed.
PHASE3_SEND_ENABLED=false
# `self` permits only the phone linked to the configured OpenWA session.
TEST_PHONE_NUMBERS=self
POLL_INTERVAL_SECONDS=60
MAX_MESSAGES_PER_RUN=5000

# Bilingual polling worker. Keep false until `npm run worker:dry-run` is reviewed.
WORKER_SEND_ENABLED=false
# Explicitly allow a Sheet containing only mobile numbers. The normalized phone
# becomes the durable unique ID; use only for recipients with WhatsApp consent.
MOBILE_ONLY_MODE=false
QUEUE_DATABASE_FILE=./data/message-queue.sqlite

# One bilingual reminder after the initial request is this many hours old.
# Requires Sheet columns: Review Completed, Follow-up Status, Follow-up Sent At.
FOLLOWUP_DELAY_HOURS=48
FOLLOWUP_SEND_ENABLED=false
